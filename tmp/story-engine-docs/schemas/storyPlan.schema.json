{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyPlan.schema.json",
  "title": "Story Plan",
  "description": "Canonical validated narrative-direction plan produced by Phase 7. It defines how the Story Blueprint should unfold and provides guidance for complete-story writing and later pagination.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "blueprintReference",
    "storyFlow",
    "scenePlan",
    "pagePlan",
    "emotionPlan",
    "symbolPlan",
    "craftPlan",
    "directorValidation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },

    "status": {
      "type": "string",
      "enum": [
        "VALIDATED"
      ]
    },

    "blueprintReference": {
      "$ref": "#/$defs/reference"
    },

    "storyFlow": {
      "$ref": "#/$defs/storyFlow"
    },

    "scenePlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },

    "pagePlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },

    "emotionPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/emotion"
      }
    },

    "symbolPlan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },

    "craftPlan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/craft"
      }
    },

    "directorValidation": {
      "$ref": "#/$defs/validation"
    }
  },

  "$defs": {

    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },

    "storyFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "centralDramaticQuestion",
        "resolution"
      ],
      "properties": {

        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/flowStage"
          }
        },

        "centralDramaticQuestion": {
          "type": "string",
          "minLength": 1
        },

        "resolution": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "flowStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose"
      ],
      "properties": {

        "id": {
          "type": "string"
        },

        "purpose": {
          "type": "string"
        },

        "beats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "beats"
      ],
      "properties": {

        "id": {
          "type": "string"
        },

        "purpose": {
          "type": "string"
        },

        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },

        "characterFocus": {
          "type": "string"
        },

        "missionProgress": {
          "type": "string"
        },

        "conflictProgression": {
          "type": "string"
        },

        "emotionalFunction": {
          "type": "string"
        },

        "symbolFunction": {
          "type": "string"
        }
      }
    },

    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "objective",
        "pageTurnGoal"
      ],
      "properties": {

        "page": {
          "type": "integer",
          "minimum": 1
        },

        "objective": {
          "type": "string",
          "minLength": 1
        },

        "beats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "sceneIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "wordBudget": {
          "$ref": "#/$defs/wordBudget"
        },

        "pageTurnGoal": {
          "type": "string",
          "minLength": 1
        },

        "emotionalPurpose": {
          "type": "string"
        },

        "visualPurpose": {
          "type": "string"
        },

        "symbolPurpose": {
          "type": "string"
        }
      }
    },

    "wordBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {

        "target": {
          "type": "integer",
          "minimum": 1
        },

        "minimum": {
          "type": "integer",
          "minimum": 0
        },

        "maximum": {
          "type": "integer",
          "minimum": 1
        }
      }
    },

    "emotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "function"
      ],
      "properties": {

        "id": {
          "type": "string"
        },

        "sceneId": {
          "type": "string"
        },

        "page": {
          "type": "integer",
          "minimum": 1
        },

        "function": {
          "type": "string"
        },

        "startingState": {
          "type": "string"
        },

        "endingState": {
          "type": "string"
        },

        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "transition": {
          "type": "string"
        }
      }
    },

    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbolId",
        "function"
      ],
      "properties": {

        "symbolId": {
          "type": "string"
        },

        "function": {
          "type": "string"
        },

        "introduction": {
          "type": "string"
        },

        "development": {
          "type": "string"
        },

        "payoff": {
          "type": "string"
        },

        "sceneIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "craft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "techniqueId",
        "purpose"
      ],
      "properties": {

        "techniqueId": {
          "type": "string"
        },

        "purpose": {
          "type": "string"
        },

        "sceneIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "beatIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "pageTurnUse": {
          "type": "string"
        }
      }
    },

    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blockingFailures",
        "warnings",
        "rulesPassed"
      ],
      "properties": {

        "status": {
          "type": "string",
          "enum": [
            "PASS"
          ]
        },

        "blockingFailures": {
          "type": "integer",
          "const": 0
        },

        "warnings": {
          "type": "integer",
          "minimum": 0
        },

        "rulesPassed": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
