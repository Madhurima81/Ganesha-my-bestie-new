        ]
      },
      {
        "page": 3,
        "text": "Kavi pressed both hands to that big belly feeling, took one slow breath, then another, and finally said, \"Wait. Let's fix this safely.\" The pause changed the whole moment.\n",
        "narration": "Kavi pressed both hands to that big belly feeling, took one slow breath, then another, and finally said, \"Wait. Let's fix this safely.\" The pause changed the whole moment.\n",
        "dialogue": [
          {
            "utteranceId": "DIA_002",
            "character": "CHAR005",
            "characterName": "Kavi",
            "text": "Wait. Let's fix this safely.",
            "delivery": "Keep the line concise, childlike, and emotionally direct.",
            "attribution": "Kavi says",
            "voiceConsistency": "Funny, impulsive",
            "punctuationStatus": "COMPLETE",
