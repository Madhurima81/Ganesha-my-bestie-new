/* ZoneWelcome.css - Clean Card Design (Match Reference Image) */
/* Path: lib/components/zone/ZoneWelcome.css */

/* Fonts: Baloo 2 for headings, Nunito for body */
@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Nunito:wght@600;700;800&display=swap');

.zone-welcome-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  margin: 0;
  padding: 0;
  animation: zoneWelcomeSlideIn 0.5s ease-out;
}

.screen {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

.bg-layer {
  position: absolute;
  inset: 0;
  background: var(--zone-bg) center/cover no-repeat;
  z-index: 0;
  filter: saturate(0.95) blur(1.5px);
}

.bg-layer::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bg-layer::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    to bottom,
    rgba(155, 123, 232, 0.12) 0%,
    rgba(155, 123, 232, 0.06) 30%,
    transparent 55%
  );
}

@keyframes zoneWelcomeSlideIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Loading State */
.zone-welcome-loading {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.loading-spinner {
  font-size: 24px;
  text-align: center;
  font-family: 'Baloo 2', cursive;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* Back to Map Button */
.zone-back-button {
  position: absolute;
  top: 20px;
  left: 20px;
  background: linear-gradient(135deg, #4CAF50, #45a049);
  border: none;
  padding: 12px 20px;
  border-radius: 50px;
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(76, 175, 80, 0.3);
  z-index: 1000;
  font-size: 15px;
  color: white;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  gap: 6px;
}

.zone-back-button:hover {
  background: linear-gradient(135deg, #45a049, #4CAF50);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(76, 175, 80, 0.4);
}

.zone-back-button:active {
  transform: translateY(0);
}

/* Zone Title - Centered at Top */
.zone-title-centered {
  position: absolute;
  top: 60px;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 100;
}

.zone-name-centered {
  font-family: 'Baloo 2', cursive;
  font-size: 42px;
  font-weight: 800;
  color: #3E2723;
  margin: 0;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
}

.zone-icon-large {
  font-size: 48px;
  display: none; /* Hide icon, show only name */
}

/* ScreenHeader scoped inside zone title bar */
.zone-title-top .screen-header {
  padding: 0;
  margin: 0;
}
.zone-title-top .screen-header-halo-wrap {
  background: none;
  box-shadow: none;
  padding: 0;
}
.zone-title-top .screen-header-title {
  font-size: clamp(36px, 4vw, 72px);
  color: var(--zone-text-primary, #6B5416);
  text-shadow:
    0 2px 10px rgba(255, 255, 255, 0.9),
    0 0 28px rgba(255, 255, 255, 0.5);
  animation: zoneTitlePulse 4s ease-in-out infinite;
  white-space: nowrap;
  margin: 0;
}

/* Scene Cards Container */
.zone-scenes-container {
  position: relative;
  z-index: 2;
  width: 100%;
  margin: 8vh auto 0;
}

.zone-title-top {
  position: absolute;
  top: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
}

@keyframes zoneTitlePulse {
  0%, 100% { text-shadow: 0 2px 10px rgba(255,255,255,0.85), 0 0 20px rgba(255,255,255,0.3); }
  50%       { text-shadow: 0 2px 10px rgba(255,255,255,0.95), 0 0 36px rgba(255,255,255,0.6); }
}

.cards-wrapper {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 82vh;
  margin: 0 auto;
  overflow: visible;
}

.cards-wrapper::before {
  content: "";
  position: absolute;
  width: 500px;
  height: 500px;
  left: 50%;
  top: 40%;
  transform: translate(-50%, -50%);
  z-index: 0;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255, 210, 120, 0.25) 0%,
    rgba(255, 210, 120, 0.1) 40%,
    transparent 70%
  );
  filter: blur(40px);
  pointer-events: none;
}

.scenes-horizontal-container {
  display: contents;
}

/* ========================================== */
/* 4-CARD PYRAMID LAYOUT                     */
/* ========================================== */
/*
        [ 4 ]           ← TOP CENTER
  [ 2 ]       [ 3 ]    ← MIDDLE ROW
        [ 1 ]           ← BOTTOM CENTER
*/

/* All cards centred on their anchor point */
.zone-scene-card {
  transform: translate(-50%, -50%);
}

/* zone-1 — BOTTOM CENTER (Modak — active/unlocked) */
.zone-1 {
  left: 50%;
  top: 80%;
}

/* zone-2 — MIDDLE LEFT (Sacred Pond) */
.zone-2 {
  left: 30%;
  top: 52%;
}

/* zone-3 — MIDDLE RIGHT (Sacred Tusk) */
.zone-3 {
  left: 70%;
  top: 52%;
}

/* zone-4 — TOP CENTER (Sacred Assembly) */
.zone-4 {
  left: 50%;
  top: 26%;
}

/* 5-card fallback */
.zone-5 {
  left: 50%;
  top: 92%;
}

/* Uniform float — no staggered jitter */
.zone-1, .zone-2, .zone-3, .zone-4, .zone-5 {
  animation-delay: 0s;
}

/* ========================================== */
/* SYMBOL MOUNTAIN - PREMIUM REFINED STYLE   */
/* ========================================== */

/* Background tint - soft saffron air */
.symbol-mountain .bg-layer::after {
  background: linear-gradient(
    to bottom,
    rgba(244, 196, 48, 0.10) 0%,
    rgba(244, 196, 48, 0.05) 30%,
    transparent 55%
  );
}

/* ------------------------------------------ */
/* CARD BASE                                  */
/* ------------------------------------------ */

.symbol-mountain .zone-card {
  border-radius: 28px;
  padding: 6px;
  background: linear-gradient(
    145deg,
    #fffaf0,
    #fff3d2
  );
  box-shadow:
    0 18px 40px rgba(107, 84, 22, 0.18),
    0 6px 18px rgba(244, 196, 48, 0.12),
    inset 0 0 0 1px rgba(255, 255, 255, 0.7);
  transition: all 0.25s ease;
  animation: floatSoft 6s ease-in-out infinite;
}

.symbol-mountain .zone-card:hover {
  transform: translateY(-6px);
}

.symbol-mountain .zone-card.locked {
  opacity: 0.55;
  filter: grayscale(40%);
  box-shadow: 0 10px 20px rgba(107, 84, 22, 0.12);
  cursor: not-allowed;
}

/* Remove purple fake base */
.symbol-mountain .zone-card::after {
  content: "";
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: -14px;
  height: 24px;
  border-radius: 24px;
  background: rgba(107, 84, 22, 0.15);
  box-shadow: 0 10px 20px rgba(107, 84, 22, 0.25);
  z-index: -1;
}

/* ------------------------------------------ */
/* INNER PANEL                                */
/* ------------------------------------------ */

.symbol-mountain .zone-inner {
  background: linear-gradient(
    180deg,
    #ffffff 0%,
    #fff8e6 100%
  );
  border-radius: 18px;
  padding: 14px 10px;
  box-shadow:
    inset 0 3px 8px rgba(255, 255, 255, 0.9),
    inset 0 -4px 10px rgba(244, 196, 48, 0.08);
  width: 100%;
}

/* ------------------------------------------ */
/* ICON CIRCLE                                */
/* ------------------------------------------ */

.symbol-mountain .icon-circle {
  width: clamp(60px, 6vw, 96px);
  height: clamp(60px, 6vw, 96px);
  border-radius: 50%;
  background: radial-gradient(
    circle at 30% 30%,
    #fffdf7,
    #ffe9b5
  );
  box-shadow:
    0 10px 20px rgba(244, 196, 48, 0.25),
    inset 0 4px 8px rgba(255, 255, 255, 0.8);
}

/* Remove strong gold glow on available scenes */
.symbol-mountain .zone-scene-card.available .scene-emoji,
.symbol-mountain .zone-scene-card.available .scene-icon-img,
.symbol-mountain .zone-scene-card.in-progress .scene-emoji,
.symbol-mountain .zone-scene-card.in-progress .scene-icon-img {
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1))
          drop-shadow(0 0 12px rgba(244, 196, 48, 0.35));
}

/* ------------------------------------------ */
/* SCENE NAME                                 */
/* ------------------------------------------ */

.symbol-mountain .scene-name {
  color: #6B5416;
}

.symbol-mountain .zone-scene-card.locked .scene-name {
  color: rgba(107, 84, 22, 0.4);
  text-shadow: none;
}

/* ------------------------------------------ */
/* BUTTON - SOFT TEMPLE STYLE                 */
/* ------------------------------------------ */

.symbol-mountain .zone-btn {
  margin-top: clamp(6px, 0.6vw, 10px);
  padding: clamp(6px, 0.6vw, 10px) clamp(10px, 1.2vw, 20px);
  border-radius: 14px;
  border: 1.5px solid #F4C430;
  background: linear-gradient(
    180deg,
    #fffaf0,
    #ffeec2
  );
  color: #6B5416;
  font-weight: 700;
  font-size: clamp(9px, 0.9vw, 13px);
  box-shadow:
    0 6px 14px rgba(107, 84, 22, 0.18),
    inset 0 2px 4px rgba(255, 255, 255, 0.8);
  transition: all 0.2s ease;
}

.symbol-mountain .zone-btn:hover {
  background: linear-gradient(
    180deg,
    #fff6dd,
    #ffe4a0
  );
  transform: translateY(-2px);
}

.symbol-mountain .zone-btn:active {
  transform: translateY(2px);
  box-shadow:
    0 3px 8px rgba(107, 84, 22, 0.2),
    inset 0 3px 6px rgba(0, 0, 0, 0.15);
}

.symbol-mountain .zone-card.locked .zone-btn,
.symbol-mountain .zone-btn.locked {
  background: #f2efe6;
  border: 1px solid rgba(107, 84, 22, 0.2);
  color: rgba(107, 84, 22, 0.4);
  box-shadow: none;
}

/* ------------------------------------------ */
/* REMOVE CHEAP GOLD PULSE EFFECTS            */
/* ------------------------------------------ */

.symbol-mountain .zone-scene-card.next-scene,
.symbol-mountain .zone-scene-card.next-scene .zone-btn {
  animation: none;
  box-shadow: none;
}

.symbol-mountain .zone-scene-card.next-scene {
  box-shadow:
    0 10px 30px rgba(244, 196, 48, 0.25);
}

/* Remove breathing glow */
.symbol-mountain .zone-scene-card.next-scene .scene-emoji,
.symbol-mountain .zone-scene-card.next-scene .scene-icon-img {
  animation: none;
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1))
          drop-shadow(0 0 18px rgba(244, 196, 48, 0.4));
}

/* ========================================== */
/* SCENE CARD - Clean Square Design           */
/* ========================================== */

.zone-scene-card {
  position: absolute;
  width: clamp(208px, 18.2vw, 312px);
  min-height: clamp(247px, 23.4vw, 377px);
  padding: 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}

/* New base card system */
.zone-card {
  border-radius: 28px;
  padding: 6px;
  background: linear-gradient(
    145deg,
    #f3f0ff,
    #ddd6f5
  );
  box-shadow:
    0 25px 50px rgba(100, 80, 160, 0.25),
    0 12px 24px rgba(120, 100, 200, 0.18),
    0 0 0 1px rgba(255, 255, 255, 0.7) inset;
  text-align: center;
  transition: all 0.25s ease;
  animation: floatSoft 6s ease-in-out infinite;
}

.zone-card:hover {
  transform: translateY(-6px);
}

.zone-card.locked {
  opacity: 0.55;
  filter: grayscale(50%);
  box-shadow: 0 15px 30px rgba(100, 80, 160, 0.15);
  cursor: not-allowed;
}

.zone-card::after {
  content: "";
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: -14px;
  height: 24px;
  border-radius: 24px;
  background: #cfc7ee;
  box-shadow: 0 10px 25px rgba(80, 60, 140, 0.35);
  z-index: -1;
}

.zone-inner {
  background: linear-gradient(
    180deg,
    #ffffff 0%,
    #f5f2ff 100%
  );
  border-radius: 22px;
  padding: 44px 34px;
  text-align: center;
  box-shadow:
    inset 0 3px 8px rgba(255, 255, 255, 0.9),
    inset 0 -6px 12px rgba(160, 140, 220, 0.15);
  width: 100%;
}

/* Hide old order indicator and stars */
.scene-order-indicator,
.scene-stars-display {
  display: none;
}

/* Scene Icon - Large at Top */
.scene-icon-area {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  position: relative;
}

.icon-circle {
  width: clamp(78px, 7.8vw, 125px);
  height: clamp(78px, 7.8vw, 125px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10px;
  background: color-mix(in srgb, var(--zone-color) 20%, white);
}

.scene-emoji {
  font-size: clamp(42px, 4.6vw, 73px);
  margin: 0;
  transition: transform 0.3s ease;
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
}

.zone-scene-card:hover .scene-emoji {
  transform: scale(1.08);
}

.zone-scene-card.locked .scene-emoji {
  filter: grayscale(80%) opacity(0.3) brightness(0.6);
}

/* Scene Icon Image Styles */
.scene-icon-img {
  width: clamp(47px, 5.2vw, 78px);
  height: clamp(47px, 5.2vw, 78px);
  object-fit: contain;
  margin: 0;
  transition: transform 0.3s ease;
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
}

.zone-scene-card:hover .scene-icon-img {
  transform: scale(1.08);
}

.zone-scene-card.locked .scene-icon-img {
  filter: grayscale(80%) opacity(0.3) brightness(0.6) drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
}

/* Lock Overlay */
.scene-lock-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.scene-lock-icon {
  font-size: 40px;
  opacity: 0.95;
  animation: moonGlow 3s ease-in-out infinite;
  display: block;
  filter: drop-shadow(0 0 8px rgba(200, 180, 255, 0.8));
}

.scene-lock-stars {
  font-size: 16px;
  position: absolute;
  top: 6px;
  right: 10px;
  animation: starTwinkle 2s ease-in-out infinite;
  opacity: 0.9;
}

@keyframes moonGlow {
  0%, 100% { transform: scale(1);     filter: drop-shadow(0 0 8px rgba(200, 180, 255, 0.8)); }
  50%       { transform: scale(1.12);  filter: drop-shadow(0 0 16px rgba(200, 180, 255, 1)); }
}

@keyframes starTwinkle {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50%       { opacity: 1;   transform: scale(1.3); }
}

/* Scene Name - Below Icon */
.scene-name-area {
  width: 100%;
  text-align: center;
  margin-bottom: 16px;
  flex-grow: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scene-name {
  font-family: 'Baloo 2', cursive;
  font-size: clamp(14px, 1.45vw, 21px);
  font-weight: 800;
  color: #3E2723;
  margin: 0;
  line-height: 1.2;
  text-align: center;
}

.zone-scene-card.locked .scene-name {
  color: #c8b4ff;
  text-shadow: 0 0 8px rgba(200, 180, 255, 0.5);
}

/* Action Buttons - Bottom */
.scene-action-integrated {
  width: 100%;
  margin-top: auto;
  display: flex;
  align-items: stretch;
  gap: 8px;
}

/* Single Button Style */
.action-button-integrated {
  width: 100%;
  padding: 16px 24px;
  border: none;
  border-radius: 50px;
  font-family: 'Nunito', sans-serif;
  font-size: 16px;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.2s ease;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  white-space: nowrap;
  position: relative;
}

.action-button-integrated:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 0 rgba(0, 0, 0, 0.15);
}

.action-button-integrated:active {
  transform: translateY(2px);
  box-shadow: 0 2px 0 rgba(0, 0, 0, 0.15);
}

/* Zone colored button */
.zone-btn {
  margin-top: clamp(8px, 0.8vw, 13px);
  padding: clamp(8px, 0.8vw, 13px) clamp(13px, 1.56vw, 26px);
  border-radius: 18px;
  border: none;
  font-weight: 700;
  font-size: clamp(12px, 1.2vw, 17px);
  color: white;
  cursor: pointer;
  background: linear-gradient(
    180deg,
    var(--zone-color),
    color-mix(in srgb, var(--zone-color) 80%, black)
  );
  box-shadow:
    0 6px 0 color-mix(in srgb, var(--zone-color) 70%, black),
    0 14px 24px rgba(124, 93, 214, 0.4),
    inset 0 2px 6px rgba(255, 255, 255, 0.6);
  transition: all 0.15s ease;
}

.zone-card.locked .zone-btn,
.zone-btn.locked {
  background: linear-gradient(#e4e1ec, #d4d1de);
  color: #8b8796;
  box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.8);
  cursor: not-allowed;
}

@keyframes floatSoft {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
  100% { transform: translateY(0px); }
}

/* Float animation is uniform — delays removed */

/* Split Buttons for In-Progress */
.action-split-container {
  width: 100%;
  display: flex;
  gap: 8px;
}

.action-button-split {
  border: none;
  border-radius: 50px;
  font-family: 'Nunito', sans-serif;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.2s ease;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14px 16px;
}

.action-button-split.continue {
  flex: 1;
}

.action-button-split.continue:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(120, 90, 180, 0.25);
}

.action-button-split.continue:active {
  transform: translateY(2px);
  box-shadow: 0 6px 12px rgba(120, 90, 180, 0.2);
}

.action-button-split.replay {
  flex: 0 0 120px; /* ✅ Fixed width for text "Replay" */
  font-size: 15px; /* ✅ Text size instead of emoji size */
  white-space: nowrap;
  padding: 14px 10px; /* ✅ Adjusted padding for text */
}

.action-button-split.replay:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(120, 90, 180, 0.25);
}

.action-button-split.replay:active {
  transform: translateY(2px);
  box-shadow: 0 6px 12px rgba(120, 90, 180, 0.2);
}

/* ========================================== */
/* JOURNEY PANEL - Bottom Progress Bar        */
/* ========================================== */

.stats-bottom-bar {
  position: absolute;
  bottom: clamp(28px, 3vh, 50px);
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
}

/* Main pill container */
.journey-panel {
  display: flex;
  align-items: center;
  gap: clamp(20px, 2.4vw, 40px);
  padding: clamp(12px, 1.2vw, 20px) clamp(28px, 3.2vw, 56px);
  border-radius: 60px;
  background: linear-gradient(180deg, #fffaf0, #ffeec2);
  box-shadow:
    0 8px 20px rgba(107, 84, 22, 0.22),
    inset 0 2px 6px rgba(255, 255, 255, 0.9);
  font-family: 'Nunito', sans-serif;
  font-weight: 800;
  color: #6B5416;
  white-space: nowrap;
}

/* Left label */
.journey-left {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: clamp(14px, 1.4vw, 22px);
}

/* Step dots */
.journey-steps {
  display: flex;
  gap: clamp(8px, 0.9vw, 14px);
}

.step {
  width: clamp(14px, 1.4vw, 22px);
  height: clamp(14px, 1.4vw, 22px);
  border-radius: 50%;
  background: rgba(107, 84, 22, 0.22);
  transition: all 0.3s ease;
}

.step.done {
  background: #F4C430;
  box-shadow: 0 0 10px rgba(244, 196, 48, 0.5);
}

/* Subtle lift on hover */
.journey-panel:hover {
  transform: translateY(-2px);
  transition: transform 0.2s ease;
}

.stats-loading {
  font-family: 'Nunito', sans-serif;
  font-size: clamp(14px, 1.4vw, 20px);
  color: #6B5416;
  font-weight: 700;
  padding: clamp(12px, 1.2vw, 20px) clamp(28px, 3.2vw, 56px);
  background: linear-gradient(180deg, #fffaf0, #ffeec2);
  border-radius: 60px;
  box-shadow: 0 8px 20px rgba(107, 84, 22, 0.22);
}

/* ========================================== */

/* ========================================== */
/* ZONE-SPECIFIC CARD SIZING (5-card zones)   */
/* ========================================== */
/* 5-card zones reuse the same base card sizing */

/* RESPONSIVE DESIGN                          */
/* ========================================== */

/* Mobile Portrait */
@media (max-width: 768px) {
  .zone-name-centered {
    font-size: 32px;
  }

  .zone-title-centered {
    top: 40px;
  }

  .zone-scenes-container {
    width: 95%;
    margin-top: 16vh;
  }

  .cards-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 10px 5px;
    height: auto;
  }

  .zone-1,
  .zone-2,
  .zone-3,
  .zone-4,
  .zone-5 {
    top: auto;
    bottom: auto;
    left: auto;
    right: auto;
    margin: 0;
  }

  .zone-scene-card {
    position: relative;
    width: 200px;
    min-height: 250px;
    padding: 6px;
  }

  .icon-circle {
    width: 80px;
    height: 80px;
  }

  .scene-emoji {
    font-size: 56px;
  }

  .scene-icon-img {
    width: 56px;
    height: 56px;
  }

  .scene-name {
    font-size: 17px;
  }

  .action-button-integrated {
    font-size: 14px;
    padding: 12px 14px;
  }

  .action-button-split {
    font-size: 13px;
    padding: 12px;
  }

  .action-button-split.replay {
    width: 60px;
    font-size: 12px;
  }

  .stats-bottom-bar {
    bottom: 30px;
    gap: 10px;
  }

  .stat-card {
    padding: 8px 14px;
  }

  .stat-card-icon {
    font-size: 20px;
  }

  .stat-card-text {
    font-size: 13px;
  }
}

/* Extra Small Mobile */
@media (max-width: 480px) {
  .zone-name-centered {
    font-size: 28px;
  }

  .zone-scenes-container {
    margin-top: 14vh;
  }

  .zone-scene-card {
    width: 160px;
    min-height: 220px;
    padding: 16px 12px;
    position: relative;
  }

  .icon-circle {
    width: 70px;
    height: 70px;
  }

  .scene-emoji {
    font-size: 52px;
  }

  .scene-icon-img {
    width: 52px;
    height: 52px;
  }

  .scene-name {
    font-size: 15px;
  }

  .action-button-integrated {
    font-size: 13px;
    padding: 10px 12px;
  }

  .stat-card {
    padding: 6px 12px;
  }

  .stat-card-text {
    font-size: 12px;
  }
}

/* Tablets */
@media (min-width: 769px) and (max-width: 1024px) {
  .zone-scene-card {
    width: 260px;
    min-height: 300px;
  }

  .icon-circle {
    width: 96px;
    height: 96px;
  }

  .scene-emoji {
    font-size: 64px;
  }

  .scene-icon-img {
    width: 64px;
    height: 64px;
  }

.scene-name {
  font-size: 20px;
  }
}

/* Landscape Mode */
@media (max-height: 600px) and (orientation: landscape) {
  .zone-title-centered {
    top: 30px;
  }

  .zone-name-centered {
    font-size: 28px;
  }

  .zone-scenes-container {
    margin-top: 12vh;
  }

  .zone-scene-card {
    width: 180px;
    min-height: 220px;
    padding: 16px 14px;
  }

  .icon-circle {
    width: 72px;
    height: 72px;
  }

  .scene-emoji {
    font-size: 52px;
  }

  .scene-icon-img {
    width: 52px;
    height: 52px;
  }

  .scene-name {
    font-size: 15px;
  }

  .action-button-integrated {
    font-size: 13px;
    padding: 10px 12px;
  }

  .stats-bottom-bar {
    bottom: 20px;
  }
}

/* Debug buttons - hide in production */
button[style*="position: fixed"][style*="background: orange"],
button[style*="position: fixed"][style*="background: purple"] {
  display: none; /* Hide debug buttons */
}

/* ========================================== */
/* VISUAL ENHANCEMENTS - GLOW & ANIMATIONS   */
/* ========================================== */

/* Golden glow for next recommended scene only */
.zone-scene-card.next-scene .scene-emoji,
.zone-scene-card.next-scene .scene-icon-img {
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1))
          drop-shadow(0 0 30px rgba(255, 200, 0, 0.9))
          drop-shadow(0 0 50px rgba(255, 215, 0, 0.6));
  animation: iconBreathe 3s ease-in-out infinite;
}

/* Subtle glow for other available/in-progress (no breathing) */
.zone-scene-card.available .scene-emoji,
.zone-scene-card.available .scene-icon-img,
.zone-scene-card.in-progress .scene-emoji,
.zone-scene-card.in-progress .scene-icon-img {
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1))
          drop-shadow(0 0 15px rgba(255, 200, 0, 0.4));
}

/* Gentle breathing animation for icons */
@keyframes iconBreathe {
  0%, 100% { 
    transform: scale(1);
  }
  50% { 
    transform: scale(1.05);
  }
}

/* Card hover bounce - more pronounced */
.zone-scene-card.available:hover,
.zone-scene-card.in-progress:hover,
.zone-scene-card.completed:hover {
  transform: translateY(-5px);
  animation: cardBounce 0.6s ease forwards;
}

@keyframes cardBounce {
  0% { transform: translateY(-5px); }
  15% { transform: translateY(-12px); }
  30% { transform: translateY(-8px); }
  45% { transform: translateY(-12px); }
  60% { transform: translateY(-8px); }
  75% { transform: translateY(-10px); }
  100% { transform: translateY(-5px); }
}

/* Extra highlight for next recommended scene */
.zone-scene-card.next-scene {
  position: relative;
  box-shadow: 0 8px 30px rgba(255, 215, 0, 0.6);
  animation: nextScenePulse 2s ease-in-out infinite;
}

@keyframes nextScenePulse {
  0%, 100% {
    box-shadow: 0 8px 30px rgba(255, 215, 0, 0.6);
  }
  50% {
    box-shadow: 0 8px 40px rgba(255, 215, 0, 0.9),
                0 0 60px rgba(255, 200, 0, 0.5);
  }
}

/* Pulse the next scene button */
.zone-scene-card.next-scene .zone-btn {
  animation: buttonPulse 2s ease-in-out infinite;
  box-shadow: 0 6px 18px rgba(255, 193, 7, 0.6);
}

@keyframes buttonPulse {
  0%, 100% {
    box-shadow: 0 4px 0 #F57C00, 0 0 20px rgba(255, 193, 7, 0.6);
  }
  50% {
    box-shadow: 0 4px 0 #F57C00, 0 0 30px rgba(255, 193, 7, 0.9),
                0 0 40px rgba(255, 215, 0, 0.5);
  }
}


@keyframes badgeBounce {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-3px) scale(1.05); }
}


@keyframes arrowBounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-8px); }
}

/* ========================================== */
/* INSTRUCTIONAL HEADER                       */
/* ========================================== */

.zone-instruction-header {
  position: absolute;
  top: 140px;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: white;
  padding: 16px 32px;
  border-radius: 50px;
  box-shadow: 0 8px 24px rgba(255, 165, 0, 0.4);
  z-index: 90;
  animation: headerFadeIn 0.8s ease-out;
}

@keyframes headerFadeIn {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.zone-instruction-text {
  font-family: 'Baloo 2', cursive;
  font-size: 22px;
  font-weight: 800;
  text-align: center;
  margin: 0;
  line-height: 1.3;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
}

.zone-instruction-icon {
  font-size: 28px;
  margin-right: 8px;
}

.zone-instruction-scene-name {
  color: #FFF;
  text-decoration: none;
  position: relative;
  display: inline-block;
  animation: sceneNamePulse 2s ease-in-out infinite;
}

@keyframes sceneNamePulse {
  0%, 100% {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }
  50% {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2),
                 0 0 10px rgba(255, 255, 255, 0.6);
  }
}

/* Success state header (green) */
.zone-instruction-header.success {
  background: linear-gradient(135deg, #66BB6A, #4CAF50);
}

/* Completion state header (purple) */
.zone-instruction-header.complete {
  background: linear-gradient(135deg, #AB47BC, #9C27B0);
}

/* Mobile adjustments for header */
@media (max-width: 768px) {
  .zone-instruction-header {
    top: 120px;
    padding: 12px 24px;
  }

  .zone-instruction-text {
    font-size: 18px;
  }

  .zone-instruction-icon {
    font-size: 24px;
  }
}

@media (max-width: 480px) {
  .zone-instruction-header {
    top: 100px;
    padding: 10px 20px;
    max-width: 90%;
  }

  .zone-instruction-text {
    font-size: 16px;
  }

  .zone-instruction-icon {
    font-size: 20px;
  }
}


/* ========================================== */
/* ZONE COMPLETE INDICATOR                    */
/* ========================================== */

/* Zone complete badge on title */
.zone-title-complete {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}

.zone-complete-badge {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: white;
  padding: 8px 16px;
  border-radius: 50px;
  font-family: 'Nunito', sans-serif;
  font-size: 18px;
  font-weight: 800;
  text-transform: uppercase;
  box-shadow: 0 4px 12px rgba(255, 165, 0, 0.5);
  animation: badgeShine 2s ease-in-out infinite;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

@keyframes badgeShine {
  0%, 100% {
    box-shadow: 0 4px 12px rgba(255, 165, 0, 0.5);
  }
  50% {
    box-shadow: 0 4px 20px rgba(255, 215, 0, 0.8),
                0 0 30px rgba(255, 193, 7, 0.4);
  }
}

/* Zone complete checkmark */
.zone-complete-check {
  font-size: 32px;
  animation: checkBounce 1s ease-in-out;
}

@keyframes checkBounce {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* Special complete header styling */
.zone-instruction-header.complete-all {
  background: linear-gradient(135deg, #AB47BC, #9C27B0);
  animation: completeHeaderPulse 3s ease-in-out infinite;
}

@keyframes completeHeaderPulse {
  0%, 100% {
    box-shadow: 0 8px 24px rgba(171, 71, 188, 0.4);
  }
  50% {
    box-shadow: 0 8px 32px rgba(171, 71, 188, 0.7),
                0 0 40px rgba(156, 39, 176, 0.5);
  }
}

/* Brief confetti animation */
.confetti-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 9999;
}

.confetti {
  position: absolute;
  width: 10px;
  height: 10px;
  background: #FFD700;
  animation: confettiFall 3s ease-out forwards;
}

@keyframes confettiFall {
  0% {
    transform: translateY(-100vh) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(100vh) rotate(720deg);
    opacity: 0;
  }
}

/* Mobile adjustments */
@media (max-width: 768px) {
  .zone-complete-badge {
    font-size: 14px;
    padding: 6px 12px;
  }

  .zone-complete-check {
    font-size: 24px;
  }
}
