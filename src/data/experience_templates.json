        { "phase": "settle",        "type": "breath_sync",    "pattern": "wave",       "text": "Let your breath rise like a soft wave… and fall gently.", "duration": 15 },
        { "phase": "release",       "type": "imagination_fx", "effect": "river_flow",  "text": "See your sad feelings floating gently downstream. You can let them go.", "duration": 10 },
        { "phase": "affirmation",   "type": "affirmation",    "text": "{{affirmation_line}}", "duration": 8 },
        { "phase": "symbol_moment", "type": "symbol_glow",    "symbol": "lotus",       "text": "The lotus blooms after rain. So do you. Always.", "duration": 6 },
        { "phase": "completion",    "type": "completion",     "next": "return_game",   "text": "Your heart feels softer and lighter now." }
      ]
    },

