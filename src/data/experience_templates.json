        { "phase": "symbol_moment", "type": "symbol_glow",    "symbol": "trunk",        "text": "Ganesha's strong trunk glows. That same strength lives inside you.", "duration": 6 },
        { "phase": "completion",    "type": "completion",     "next": "return_game",    "text": "The path is clear. You are ready." }
      ]
