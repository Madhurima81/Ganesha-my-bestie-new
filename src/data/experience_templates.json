{
  "meta": {
    "version": "1.0",
    "phase_engine": "arrival → settle → release → affirmation → symbol_moment → completion",
    "total_templates": 8,
    "note": "affirmation_line is a dynamic slot. System inserts from affirmation_bank based on emotion context."
  },

  "intensity_scale": {
    "mild":   { "settle_duration": 10, "release_duration": 8,  "total_phases": 4 },
    "medium": { "settle_duration": 15, "release_duration": 10, "total_phases": 5 },
    "strong": { "settle_duration": 20, "release_duration": 15, "total_phases": 6 }
  },

  "templates": [

    {
      "template_id": "TEMP_STILL_STAR_01",
      "template_name": "Star Calm Focus",
      "template_type": "still_focus_journey",
      "emotional_goal": "slow_thoughts",
      "primary_emotion_family": ["anxiety", "overwhelm", "confusion"],
      "focus_object_type": "star_light",
      "default_soundscape": "cave_echo",
      "preferred_zone": "cave",
      "energy_shift_result": "focus",
      "phases": [
        { "phase": "arrival",       "type": "focus_object",   "asset": "star",        "text": "One tiny star is shining just for you. Come and look at it.", "duration": 8 },
        { "phase": "settle",        "type": "breath_sync",    "pattern": "slow",      "text": "Breathe in slowly… and breathe out. Let your eyes go soft.", "duration": 15 },
        { "phase": "release",       "type": "imagination_fx", "effect": "cloud_clear","text": "Watch your busy thoughts float away like clouds. The sky gets clear.", "duration": 10 },
        { "phase": "affirmation",   "type": "affirmation",    "text": "{{affirmation_line}}", "duration": 8 },
        { "phase": "symbol_moment", "type": "symbol_glow",    "symbol": "eyes",       "text": "Ganesha's wise eyes glow softly. You carry this clarity now.", "duration": 6 },
        { "phase": "completion",    "type": "completion",     "next": "return_game",  "text": "Your mind is clear and bright." }
      ]
    },

    {
      "template_id": "TEMP_BREATH_FLOW_01",
      "template_name": "Lotus Bloom Healing",
      "template_type": "breath_journey",
      "emotional_goal": "soothe_body",
      "primary_emotion_family": ["sadness", "loneliness", "disappointment"],
      "focus_object_type": "breathing_orb",
      "default_soundscape": "flowing_water",
      "preferred_zone": "river",
      "energy_shift_result": "settle",
