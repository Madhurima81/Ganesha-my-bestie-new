/* ====================================================== */
/* SHARED OPENING MODAL STYLES (Universal for 24 Scenes)  */
/* ====================================================== */

:root {
  --modal-overlay-bg: rgba(0, 0, 0, 0.55);
  --modal-card-bg: #FFF9E6;
  --modal-card-border: none;
  --modal-text-primary: #5D2E0F;
  --modal-text-secondary: #333333;
  --modal-btn-bg: linear-gradient(135deg, #FFA500 0%, #FF8C00 100%);
  --modal-btn-text: #FFFFFF;
  --modal-btn-shadow: rgba(255, 140, 0, 0.4);
  --modal-shadow-color: rgba(0, 0, 0, 0.3);
}

/* --- Main Container --- */
.game-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--modal-overlay-bg);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: modalFadeIn 0.3s ease-out;
  backdrop-filter: blur(3px);
}

.game-modal-content {
  position: relative;
  width: 95%;
  max-width: 1700px;
  height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 50px;
  padding: 0 60px;
}

/* Character (Left Side) */
.game-modal-character {
  flex: 0 0 35%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  z-index: 2;
}

.game-modal-character img {
  width: 100%;
  max-width: 720px;
  height: auto;
  filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.25));
  transform: scaleX(-1);
  animation: charBreathe 3s ease-in-out infinite;
}

/* Card (Right Side) */
.game-modal-card {
  flex: 0 0 50%;
  max-width: 700px;
  min-height: 600px;
  background: linear-gradient(180deg, #FFF9E6 0%, #FFF4D8 100%);
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.22);
  border-radius: 36px;
  padding: 70px 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  animation: slideInRight 0.6s ease-out;
}

.game-modal-title {
  font-family: 'Baloo 2', cursive;
  font-size: 60px !important;
  font-weight: 800;
  color: var(--modal-text-primary);
  margin-bottom: 30px;
  line-height: 1.1;
  width: 100%;
}

.game-modal-subtitle {
  font-family: 'Nunito', sans-serif;
  font-size: 36px !important;
  color: var(--modal-text-secondary);
  line-height: 1.4;
  margin-bottom: 30px !important;
  max-width: 90%;
}

/* --- Icons Grid --- */
.game-modal-icons {
  display: flex;
  justify-content: center;
  gap: 40px;
  margin: 30px 0 45px;
  width: 100%;
  flex-wrap: wrap;
}

.game-modal-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.game-modal-icon-item:hover {
  transform: scale(1.1) rotate(3deg);
}

.game-modal-icon-item img,
.game-modal-icon-circle {
  width: 120px;
  height: 120px;
  object-fit: contain;
  filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.08));
  animation: iconFloatSoft 4s ease-in-out infinite;
  background: transparent;
  border-radius: 0;
  padding: 0;
  border: none;
}

/* Hard override to beat legacy modal styles elsewhere */
.game-modal-icons .game-modal-icon-circle,
.game-modal-icons .game-modal-icon-item img {
  width: 120px !important;
  height: 120px !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  padding: 0 !important;
}

.game-modal-icon-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70px;
  background: transparent;
}

.game-modal-icon-item:nth-child(1) img,
.game-modal-icon-item:nth-child(1) .game-modal-icon-circle {
  animation-delay: 0s;
}

.game-modal-icon-item:nth-child(2) img,
.game-modal-icon-item:nth-child(2) .game-modal-icon-circle {
  animation-delay: 0.5s;
}

.game-modal-icon-item:nth-child(3) img,
.game-modal-icon-item:nth-child(3) .game-modal-icon-circle {
  animation-delay: 1s;
}

.game-modal-icon-label {
  font-family: 'Baloo 2', cursive;
  font-size: 20px;
  font-weight: 700;
  color: var(--modal-text-primary);
  letter-spacing: 0.5px;
  display: none;
}

/* --- Button --- */
.game-modal-button {
  font-family: 'Baloo 2', cursive;
  background: var(--modal-btn-bg);
  color: var(--modal-btn-text);
  border: 2px solid var(--modal-btn-border, transparent);
  padding: 20px 60px;
  font-size: 30px;
  font-weight: 800;
  border-radius: 90px;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  box-shadow: 0 10px 28px var(--modal-btn-shadow);
  text-transform: capitalize;
  white-space: nowrap;
  margin-top: 20px;
}

.game-modal-button:hover {
  transform: translateY(-4px);
  background: var(--modal-btn-bg-hover, var(--modal-btn-bg));
  box-shadow: 0 14px 40px var(--modal-btn-shadow);
}

/* Force zone-themed button even if older styles are injected elsewhere */
.game-modal-card .game-modal-button {
  background: var(--modal-btn-bg) !important;
  color: var(--modal-btn-text) !important;
  border: 2px solid var(--modal-btn-border, transparent) !important;
  box-shadow: 0 10px 28px var(--modal-btn-shadow) !important;
}

.game-modal-card .game-modal-button:hover {
  background: var(--modal-btn-bg-hover, var(--modal-btn-bg)) !important;
  box-shadow: 0 14px 40px var(--modal-btn-shadow) !important;
}

.game-modal-button:active {
  transform: translateY(2px);
}

/* --- Animations --- */
@keyframes modalFadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(50px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes charBreathe {

  0%,
  100% {
    transform: scaleX(-1) scaleY(1);
  }

  50% {
    transform: scaleX(-1) scaleY(1.02);
  }
}

@keyframes iconFloatSoft {
  0%, 100% {
    transform: translateY(0);
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.06));
  }
  50% {
    transform: translateY(-6px);
    filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.09));
  }
}

/* ====================================================== */
/* RESPONSIVE MEDIA QUERIES                               */
/* ====================================================== */

/* MOBILE PORTRAIT */
@media (max-width: 600px) {
  .game-modal-content {
    flex-direction: column;
    height: auto;
    min-height: 80vh;
    padding: 20px;
    gap: 0;
  }

  .game-modal-character {
    margin-bottom: -30px;
    z-index: 2;
    justify-content: center;
    flex: 0 0 auto;
  }

  .game-modal-character img {
    width: 180px;
  }

  .game-modal-card {
    padding: 50px 20px 30px;
    width: 100%;
    z-index: 1;
    flex: 0 0 auto;
    border-radius: 25px;
  }

  .game-modal-title {
    font-size: 28px !important;
  }

  .game-modal-subtitle {
    font-size: 16px !important;
    margin-bottom: 15px !important;
  }

  .game-modal-icons {
    gap: 20px;
    margin-bottom: 25px;
  }

  .game-modal-icon-item img,
  .game-modal-icon-circle {
    width: 80px;
    height: 80px;
    padding: 0;
  }

  .game-modal-icon-circle {
    font-size: 30px;
  }

  .game-modal-button {
    font-size: 20px;
    padding: 15px 40px;
    width: 100%;
  }
}

/* MOBILE LANDSCAPE */
@media (min-width: 568px) and (max-width: 1019px) and (orientation: landscape) {
  .game-modal-content {
    width: 100%;
    height: 95vh;
    padding: 0 20px;
    gap: 20px;
  }

  .game-modal-character {
    flex: 0 0 25%;
  }

  .game-modal-character img {
    max-height: 280px;
    width: auto;
  }

  .game-modal-card {
    flex: 1;
    padding: 20px 30px;
    max-width: none;
    min-height: auto;
  }

  .game-modal-title {
    font-size: 28px !important;
    margin-bottom: 10px;
  }

  .game-modal-subtitle {
    font-size: 15px !important;
    margin-bottom: 10px !important;
  }

  .game-modal-icons {
    gap: 30px;
    margin-bottom: 15px;
  }

  .game-modal-icon-item img,
  .game-modal-icon-circle {
    width: 90px;
    height: 90px;
    padding: 0;
  }

  .game-modal-icon-circle {
    font-size: 40px;
  }

  .game-modal-button {
    font-size: 20px;
    padding: 10px 40px;
    margin-top: 10px;
  }
}

/* iPAD & DESKTOP */
@media (min-width: 768px) and (max-width: 1024px) {
  .game-modal-card {
    padding: 50px 40px;
  }

  .game-modal-title {
    font-size: 44px !important;
  }

  .game-modal-subtitle {
    font-size: 24px !important;
  }

  .game-modal-icon-item img,
  .game-modal-icon-circle {
    width: 110px;
    height: 110px;
  }
}
