// zones/shloka-river/scenes/Scene3/KurumedevaGame.jsx
// Thin wrapper for Game 6 - connects config to engine

import React from 'react';
import MemoryGameEngine from '../../core/MemoryGameEngine';
import { getGameConfig } from '../../configs/gameConfigs';

const KurumedevaGame = ({
  isActive,
  hideElements,
  powerGained,
  onPhaseComplete,
  onGameComplete,
  profileName,
  WaterSprayComponent,

  // ⭐ CHANGED: Assets specific to Kurumedeva game
  getKurumedevaPlainDecorImage,      // Initial state (plain decoration)
  getKurumedevaColoredDecorImage,    // Reward state (colored decoration)
  getKurumedevaItemImage,            // Clicker (item)

  // Mode control
  selectedMode,
  skipModeSelection,

  // Reload support
  isReload,
  savedGameState,
  onSaveGameState
}) => {

  // ⭐ CHANGED: Get Kurumedeva config
  const gameConfig = getGameConfig('kurumedeva');

  // ⭐ CHANGED: Map asset getters to config names
  const assetGetters = {
    getKurumedevaPlainDecorImage,     // matches: gameConfig.elements.singer.assetGetterInitial
    getKurumedevaColoredDecorImage,   // matches: gameConfig.elements.singer.assetGetterReward
    getKurumedevaItemImage            // matches: gameConfig.elements.clicker.assetGetter
  };

  if (!gameConfig) {
    console.error('❌ KurumedevaGame: Config not found for "kurumedeva"');
    return null;
  }
  
  return (
    <MemoryGameEngine
      gameConfig={gameConfig}
      assetGetters={assetGetters}
      isActive={isActive}
      hideElements={hideElements}
      powerGained={powerGained}
      onPhaseComplete={onPhaseComplete}
      onGameComplete={onGameComplete}
      profileName={profileName}
      WaterSprayComponent={WaterSprayComponent}
      selectedMode={selectedMode}          
      skipModeSelection={skipModeSelection} 
      isReload={isReload}
      savedGameState={savedGameState}
      onSaveGameState={onSaveGameState}
    />
  );
};

export default KurumedevaGame;