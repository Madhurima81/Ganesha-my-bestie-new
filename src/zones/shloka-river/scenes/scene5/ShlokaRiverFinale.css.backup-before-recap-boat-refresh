.srf-container {
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  overflow: hidden;
  position: relative;
  background-size: 100% 100%;
  background-position: center center;
  background-repeat: no-repeat;
  display: flex;
  flex-direction: column;
}

.srf-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-family: 'Nunito', sans-serif;
  gap: 16px;
}

.srf-arrange {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.srf-title-banner {
  text-align: center;
  padding: 8px 24px;
  margin-top: 2px;
  z-index: 12;
}

.srf-title {
  font-family: 'Baloo 2', cursive;
  font-size: clamp(20px, 4vw, 32px);
  color: #fff;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  margin: 0;
}

.srf-subtitle {
  font-family: 'Nunito', sans-serif;
  font-size: clamp(11px, 2vw, 15px);
  color: rgba(255, 255, 255, 0.88);
  margin: 2px 0 0;
}

.srf-progress-badge {
  position: absolute;
  top: 18px;
  right: 22px;
  min-width: 70px;
  padding: 8px 14px;
  border-radius: 999px;
  background: rgba(255, 248, 214, 0.94);
  box-shadow: 0 8px 22px rgba(109, 77, 27, 0.16);
  font-family: 'Nunito', sans-serif;
  font-size: clamp(13px, 1.9vw, 16px);
  font-weight: 800;
  color: #7a4d20;
  text-align: center;
  z-index: 15;
}

.srf-river-area {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  position: relative;
  padding: 12vh 28px 0;
}

.srf-slot-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: clamp(14px, 2.6vh, 24px);
  column-gap: clamp(8px, 1.1vw, 12px);
  width: min(58vw, 590px);
  max-width: 590px;
}

.srf-slot {
  aspect-ratio: 1.22 / 0.98;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.05);
  cursor: pointer;
  transition: opacity 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
}

.srf-slot.is-active,
.srf-slot.is-hint-slot {
  background: rgba(255, 255, 255, 0.05);
}

.srf-slot.is-active::after,
.srf-slot.is-hint-slot::after {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 16px;
  box-shadow:
    0 0 12px rgba(255, 255, 255, 0.5),
    0 0 24px rgba(255, 220, 120, 0.4);
  animation: srf-activePulse 2s ease-in-out infinite;
  pointer-events: none;
}

.srf-slot.is-active::before,
.srf-slot.is-hint-slot::before {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 50%;
  width: 60px;
  height: 14px;
  transform: translateX(-50%);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  animation: srf-waterRipple 2s infinite;
  pointer-events: none;
}

.srf-slot.is-locked {
  opacity: 0.42;
  pointer-events: none;
  filter: saturate(0.72);
}

.srf-slot.is-filled {
  background: rgba(255, 255, 255, 0.08);
}

.srf-slot.is-correct {
  background: rgba(255, 255, 255, 0.03) !important;
}

.srf-slot.is-wrong {
  animation: srf-shake 0.35s ease;
  border-color: rgba(201, 184, 255, 0.9) !important;
  background: rgba(239, 235, 255, 0.18) !important;
  box-shadow:
    0 0 0 2px rgba(201, 184, 255, 0.18),
    0 0 14px rgba(201, 184, 255, 0.16);
}

@keyframes srf-shake {
  0%,
  100% {
    transform: translateX(0);
  }

  20% {
    transform: translateX(-5px);
  }

  40% {
    transform: translateX(5px);
  }

  60% {
    transform: translateX(-3px);
  }

  80% {
    transform: translateX(3px);
  }
}

@keyframes srf-activePulse {
  0%,
  100% {
    opacity: 0.4;
    transform: scale(0.98);
  }

  50% {
    opacity: 1;
    transform: scale(1.03);
  }
}

@keyframes srf-waterRipple {
  0% {
    opacity: 0.6;
    transform: translateX(-50%) scale(0.8);
  }

  100% {
    opacity: 0;
    transform: translateX(-50%) scale(1.4);
  }
}

.srf-slot-number {
  position: absolute;
  top: 3px;
  left: 6px;
  font-family: 'Baloo 2', cursive;
  font-size: clamp(10px, 1.5vw, 14px);
  font-weight: 700;
  color: rgba(255, 255, 255, 0.35);
  z-index: 2;
}

.srf-slot-q {
  position: absolute;
  font-family: 'Baloo 2', cursive;
  font-size: clamp(18px, 3vw, 28px);
  color: rgba(255, 255, 255, 0.15);
  pointer-events: none;
}

.srf-placed-boat,
.srf-ghost-boat {
  width: 88%;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.srf-placed-boat .boat-svg,
.srf-ghost-boat .boat-svg {
  width: 100%;
}

.srf-slot.is-correct .srf-placed-boat {
  filter:
    brightness(1.1)
    drop-shadow(0 0 8px rgba(255, 220, 120, 0.5));
  animation: srf-boatBob 3s ease-in-out infinite;
}

.srf-placed-boat.is-all-complete {
  animation: srf-glowPulse 1.5s ease-in-out infinite, srf-floatUp 1s ease forwards;
}

.srf-placed-boat.is-hero-boat {
  z-index: 10;
  animation: srf-heroFocus 1s ease forwards;
}

.srf-placed-boat.is-dissolve {
  animation: srf-dissolveBoat 1s ease forwards;
}

.srf-boat-icon {
  position: absolute;
  top: 20%;
  left: 50%;
  transform: translateX(-50%);
  width: 28%;
  pointer-events: none;
  z-index: 2;
}

.srf-boat-label {
  font-family: 'Baloo 2', cursive;
  font-size: clamp(8px, 1.4vw, 12px);
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  margin-top: -4px;
  text-align: center;
  white-space: nowrap;
}

.srf-slot-check {
  display: none;
}

.srf-slot.is-ripple::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 18px;
  background:
    radial-gradient(circle at 24% 34%, rgba(255,255,255,0.9) 0 2px, transparent 3px),
    radial-gradient(circle at 43% 26%, rgba(255,232,160,0.9) 0 2px, transparent 3px),
    radial-gradient(circle at 58% 52%, rgba(255,255,255,0.85) 0 2px, transparent 3px),
    radial-gradient(circle at 74% 35%, rgba(255,232,160,0.85) 0 2px, transparent 3px),
    radial-gradient(circle at 38% 70%, rgba(255,255,255,0.8) 0 2px, transparent 3px),
    radial-gradient(circle at 68% 72%, rgba(255,232,160,0.8) 0 2px, transparent 3px);
  animation: srf-sparklePop 0.8s ease forwards;
  pointer-events: none;
}

@keyframes srf-sparklePop {
  0% {
    opacity: 0;
    transform: scale(0.5);
  }

  40% {
    opacity: 1;
    transform: scale(1.2);
  }

  100% {
    opacity: 0;
    transform: scale(1.8);
  }
}

@keyframes srf-boatBob {
  0% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-3px);
  }

  100% {
    transform: translateY(0);
  }
}

@keyframes srf-glowPulse {
  0% {
    filter: brightness(1);
  }

  50% {
    filter: brightness(1.2) drop-shadow(0 0 12px rgba(255, 230, 120, 0.8));
  }

  100% {
    filter: brightness(1);
  }
}

@keyframes srf-floatUp {
  from {
    transform: translateY(0);
  }

  to {
    transform: translateY(-12px);
  }
}

@keyframes srf-heroFocus {
  from {
    transform: scale(1);
  }

  to {
    transform: scale(1.2);
  }
}

@keyframes srf-dissolveBoat {
  from {
    opacity: 1;
    transform: scale(1);
  }

  to {
    opacity: 0;
    transform: scale(0.8);
  }
}

.srf-tray {
  width: 100%;
  background: rgba(40, 20, 80, 0.75);
  backdrop-filter: blur(8px);
  min-height: 108px;
  padding: 6px 10px 12px;
  z-index: 12;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.srf-tray-label {
  font-family: 'Nunito', sans-serif;
  font-size: clamp(10px, 1.8vw, 13px);
  font-weight: 700;
  color: rgba(255, 255, 255, 0.72);
  text-align: center;
  margin: 0 0 4px;
}

.srf-tray-boats {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-start;
  gap: clamp(4px, 1vw, 10px);
  min-height: 72px;
}

.srf-tray-boat {
  width: clamp(56px, 8.4vw, 78px);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: grab;
  transition: opacity 0.3s, transform 0.2s;
  touch-action: none;
  padding-top: 2px;
}

.srf-tray-boat:active {
  cursor: grabbing;
  transform: scale(1.08);
}

.srf-tray-boat .boat-svg {
  width: 100%;
}

.srf-tray-boat .srf-boat-icon {
  width: 32%;
  top: 16%;
}

.srf-tray-boat .srf-boat-label {
  font-size: clamp(7px, 1.2vw, 10px);
  margin-top: -2px;
}

.srf-tray-boat.is-hint-pulse {
  animation: srf-trayPulse 1.2s ease-in-out infinite;
}

.srf-tray-boat.is-hint-wiggle {
  animation: srf-trayWiggle 1s ease-in-out infinite;
}

@keyframes srf-trayPulse {
  0%,
  100% {
    transform: scale(1);
    filter: drop-shadow(0 0 0 rgba(255, 214, 102, 0));
  }

  50% {
    transform: scale(1.08);
    filter: drop-shadow(0 0 12px rgba(255, 214, 102, 0.55));
  }
}

@keyframes srf-trayWiggle {
  0%,
  100% {
    transform: rotate(0deg) scale(1.03);
  }

  25% {
    transform: rotate(-3deg) scale(1.06);
  }

  75% {
    transform: rotate(3deg) scale(1.06);
  }
}

.srf-drag-ghost {
  position: absolute;
  width: clamp(70px, 12vw, 100px);
  transform: translate(-50%, -60%);
  pointer-events: none;
  z-index: 50;
  opacity: 0.92;
  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.4));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.srf-drag-ghost .boat-svg {
  width: 100%;
}

.srf-drag-ghost .srf-boat-icon {
  width: 30%;
  top: 18%;
}

.srf-drag-ghost .srf-boat-label {
  font-size: 10px;
}

.srf-success-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 60;
}

.srf-success-overlay::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 35%, rgba(255,255,255,0.6) 0 2px, transparent 3px),
    radial-gradient(circle at 32% 62%, rgba(255,244,179,0.7) 0 2px, transparent 3px),
    radial-gradient(circle at 50% 44%, rgba(255,255,255,0.7) 0 3px, transparent 4px),
    radial-gradient(circle at 64% 58%, rgba(255,244,179,0.7) 0 2px, transparent 3px),
    radial-gradient(circle at 78% 30%, rgba(255,255,255,0.55) 0 2px, transparent 3px);
  animation: srf-riverSparkle 1.8s ease-in-out infinite;
}

.srf-success-glow {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.12);
  animation: srf-glow-pulse 2.5s ease;
}

@keyframes srf-glow-pulse {
  0% {
    opacity: 0;
  }

  40% {
    opacity: 1;
  }

  100% {
    opacity: 0;
  }
}

@keyframes srf-riverSparkle {
  0%,
  100% {
    opacity: 0.55;
  }

  50% {
    opacity: 1;
  }
}

.srf-success-text {
  font-family: 'Baloo 2', cursive;
  font-size: clamp(24px, 5vw, 42px);
  color: #fff;
  text-shadow: 0 2px 16px rgba(255, 216, 102, 0.5), 0 4px 20px rgba(0, 0, 0, 0.3);
  animation: srf-success-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 61;
}

@keyframes srf-success-pop {
  0% {
    transform: scale(0.5);
    opacity: 0;
  }

  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.srf-recap {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 30;
}

.srf-recap-boat {
  position: absolute;
  bottom: 12%;
  width: clamp(120px, 25vw, 220px);
  left: 35%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.srf-recap-boat .boat-svg {
  width: 100%;
}

.srf-recap-boat .srf-boat-icon {
  width: 28%;
  top: 18%;
}

.srf-recap-boat .srf-boat-label {
  margin-top: -2px;
}

.srf-recap-boat.is-sailing {
  animation: srf-sail 8s linear forwards;
}

.srf-recap-boat img,
.srf-recap-boat .boat-svg {
  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));
}

@keyframes srf-sail {
  from {
    left: 35%;
  }

  to {
    left: 70%;
  }
}

.srf-recap-word {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  animation: srf-word-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes srf-word-pop {
  0% {
    transform: scale(0);
    opacity: 0;
  }

  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.srf-recap-icon {
  width: clamp(48px, 10vw, 80px);
  filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
}

.srf-recap-label {
  font-family: 'Baloo 2', cursive;
  font-size: clamp(28px, 5vw, 48px);
  font-weight: 800;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
}

.srf-recap-dots {
  position: absolute;
  bottom: 6%;
  display: flex;
  gap: 8px;
}

.srf-recap-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  transition: all 0.3s;
}

.srf-recap-dot.is-done {
  background: var(--dot-color, #ffd700);
  box-shadow: 0 0 8px var(--dot-color, #ffd700);
}

.srf-recap-dot.is-current {
  background: #fff;
  transform: scale(1.4);
  box-shadow: 0 0 12px #fff;
}

.srf-finale {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  z-index: 40;
}

.srf-shloka-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20px;
  padding: clamp(16px, 3vw, 32px) clamp(24px, 5vw, 48px);
  text-align: center;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  animation: srf-card-in 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes srf-card-in {
  0% {
    transform: scale(0.7);
    opacity: 0;
  }

  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.srf-shloka-line {
  font-family: 'Baloo 2', cursive;
  font-size: clamp(16px, 3vw, 26px);
  font-weight: 700;
  margin: 4px 0;
  display: flex;
  gap: clamp(8px, 2vw, 20px);
  justify-content: center;
}

.srf-line-1 span {
  color: #ff5722;
}

.srf-line-1 span:nth-child(2) {
  color: #1565c0;
}

.srf-line-2 span {
  color: #ff9800;
}

.srf-line-2 span:nth-child(2) {
  color: #e91e63;
}

.srf-line-3 span {
  color: #009688;
}

.srf-line-3 span:nth-child(2) {
  color: #7b1fa2;
}

.srf-line-4 span {
  color: #3f51b5;
}

.srf-line-4 span:nth-child(2) {
  color: #689f38;
}

.srf-shloka-divider {
  font-size: 20px;
  margin: 4px 0;
}

.srf-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #6a1b9a, #4a148c);
  border: 3px solid #ffd700;
  border-radius: 16px;
  padding: 8px 24px;
  box-shadow: 0 4px 20px rgba(106, 27, 154, 0.4);
  animation: srf-badge-pop 0.6s 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes srf-badge-pop {
  0% {
    transform: scale(0);
    opacity: 0;
  }

  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.srf-badge-label {
  font-family: 'Nunito', sans-serif;
  font-size: clamp(10px, 1.8vw, 14px);
  font-weight: 700;
  color: rgba(255, 255, 255, 0.8);
}

.srf-badge-title {
  font-family: 'Baloo 2', cursive;
  font-size: clamp(20px, 4vw, 32px);
  font-weight: 800;
  color: #ffd700;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
}

.boat-svg {
  display: block;
}

.srf-slot,
.srf-tray-boat {
  min-width: 60px;
  min-height: 60px;
}

@media (min-width: 768px) {
  .srf-slot-grid {
    row-gap: 22px;
    column-gap: 12px;
  }

  .srf-tray-boats {
    gap: 10px;
  }
}

@media (max-width: 480px) {
  .srf-title-banner {
    padding: 4px 12px;
  }

  .srf-tray {
    min-height: 96px;
    padding: 6px 8px 10px;
  }

  .srf-river-area {
    padding: 10vh 8px 0;
  }

  .srf-slot-grid {
    width: min(88vw, 440px);
    row-gap: 14px;
  }

  .srf-progress-badge {
    top: 14px;
    right: 12px;
  }
}
